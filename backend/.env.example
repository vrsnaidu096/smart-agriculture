PORT=3000
DATABASE_URL=./database.sqlite

# API Keys
# Note: Weather intelligence uses Open-Meteo, which requires no API key for non-commercial use.
SOIL_API_KEY=your_soil_api_key_here
MAP_API_KEY=your_map_api_key_here

# Image capture / dataset collection
IMAGE_STORAGE_DIR=storage/scans
MAX_IMAGES_PER_SCAN=8
MAX_IMAGE_BYTES=8388608

# Shared secret for the label-review API. Leave blank to disable the endpoint.
REVIEW_TOKEN=

# Python inference sidecar (see ../ml). Disease analysis has no fallback:
# if this service is down the API reports UNAVAILABLE rather than guessing.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=20000
